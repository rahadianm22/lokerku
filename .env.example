# Salin ke .env.local lalu isi. Tanpa tiga nilai Google + secret di bawah,
# Lokerku tetap jalan dalam mode tamu (data hanya di browser).

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# String acak panjang, mis. hasil: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL publik aplikasi. Lokal: http://localhost:3000 · Vercel: https://nama-proyek.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Email kontak yang tampil di halaman /privasi (dilihat Google saat verifikasi OAuth)
CONTACT_EMAIL=
